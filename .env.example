# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
MYSTERYSECURITYTEAM_IMAGE=ruoji6/mysterysecurityteam
MYSTERYSECURITYTEAM_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MYSTERYSECURITYTEAM_LLM_PROVIDER=
MYSTERYSECURITYTEAM_LLM_MODEL=
MYSTERYSECURITYTEAM_LLM_BASE_URL=
MYSTERYSECURITYTEAM_LLM_PROXY=
