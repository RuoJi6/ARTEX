# Docker deployment settings. Copy this file to .env for repository deployments.
# Docker Hub image published by this repository; see README for deployment details.
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Host directory for persistent application data (data/). Defaults to /opt/artex.
ARTEX_DATA_DIR=/opt/artex

# Host port mapped to the ARTEX web UI/API. Defaults to 8787.
ARTEX_PORT=8787

# Optional LLM settings. These can also be configured in the ARTEX UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
