# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（任选其一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTP User-Agent；留空时从浏览器 UA 样本中随机抽选，填写则使用固定值
ARTEX_HTTP_USER_AGENT=

# 容器与工具执行资源上限（防止单个子进程吃满宿主机内存导致 swap 抖动）
# ARTEX_MEMORY_LIMIT 同时用于 Docker mem_limit 与 memswap_limit（默认 4g，禁止容器使用宿主机 swap）
# 小内存 VPS（如 4G/8G）建议按宿主机可用内存的一半左右设置，为系统和 PostgreSQL 留出余量
ARTEX_MEMORY_LIMIT=4g
ARTEX_PIDS_LIMIT=512
# 单条 Bash / 自定义命令或脚本工具的内存上限（MiB，默认 2048；设为 0 关闭）
ARTEX_TOOL_MEMORY_LIMIT_MB=2048
# Bash 和自定义命令/脚本的默认超时时间（秒，默认 120）
ARTEX_TOOL_TIMEOUT_S=120
# 单条命令的进程/线程数上限（仅在 Linux cgroup v2 可委托时生效，默认 256；设为 0 关闭）
ARTEX_TOOL_PIDS_LIMIT=256
