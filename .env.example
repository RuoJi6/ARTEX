# Docker deployment settings. Copy this file to .env for repository deployments.
# Docker Hub image published by this repository; see README for deployment details.
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
# Deployment mode: monolith (frontend embedded in the binary) or separated (nginx + api).
ARTEX_MODE=monolith
# Images used in separated mode (api 后端 / nginx 前端).
ARTEX_API_IMAGE=artex-api
ARTEX_NGINX_IMAGE=artex-nginx
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Host directory for persistent application data (data/). Defaults to /opt/artex.
ARTEX_DATA_DIR=/opt/artex

# Exposed port: HTTP UI/API (monolith, default 8787) or HTTPS (separated, default 443).
ARTEX_PORT=8787
# HTTP port in separated mode (80 → HTTPS redirect). Defaults to 80.
ARTEX_HTTP_PORT=80

# Optional LLM settings. These can also be configured in the ARTEX UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
